{
  "name": "kart-blitz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kart Blitz - an arcade kart racer built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "snap": "node scripts/snap.mjs",
    "check": "esbuild src/main.js --bundle --format=esm --log-level=warning --loader:.css=empty --loader:.woff=empty --loader:.woff2=empty --loader:.png=empty --loader:.svg=empty --outfile=/dev/null",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "vite": "^8.3.1"
  }
}
